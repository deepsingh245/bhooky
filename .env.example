# Copy this file to apps/functions/.env and fill in real values.

# Google Gemini API key (https://aistudio.google.com/apikey)
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash

# Swiggy MCP data source: "mock" (default, no credentials needed) or "live"
SWIGGY_MCP_MODE=mock

# Only needed once SWIGGY_MCP_MODE=live and you have Builders Club staging access
SWIGGY_MCP_BASE_URL=https://mcp.swiggy.com
