# Copy this file to apps/functions/.env and fill in real values.

# Google Gemini API key (https://aistudio.google.com/apikey)
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash

# Swiggy MCP data source: "mock" (default, no credentials needed) or "live"
SWIGGY_MCP_MODE=mock

# Only needed once SWIGGY_MCP_MODE=live and you have Builders Club staging access
SWIGGY_MCP_BASE_URL=https://mcp.swiggy.com

# Real Swiggy OAuth 2.1 PKCE flow (BHOOKY_BUILD_PLAN.md §7) — issued alongside
# Builders Club staging credentials. SWIGGY_OAUTH_REDIRECT_URI must exactly
# match the HTTPS URL of oauthCallbackHandler (localhost is fine for dev).
SWIGGY_OAUTH_CLIENT_ID=
SWIGGY_OAUTH_REDIRECT_URI=http://localhost:5001/demo-bhooky/asia-south1/oauthCallbackHandler

# Web app origin oauthCallbackHandler redirects the browser back to once the
# token exchange finishes.
BHOOKY_WEB_URL=http://localhost:5173
