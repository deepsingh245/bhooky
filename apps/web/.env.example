# Copy this file to apps/web/.env and fill in real values.
# Only needed when deploying against a real Firebase project — local dev
# against the emulators works with none of these set (falls back to the
# emulator-only "demo-bhooky" config in src/lib/firebase.ts).

VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
