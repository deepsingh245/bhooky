{
  "functions": [
    {
      "source": "apps/functions",
      "codebase": "default",
      "runtime": "nodejs20",
      "predeploy": ["npm --prefix apps/functions run build"]
    }
  ],
  "firestore": {
    "rules": "firestore.rules",
    "indexes": "firestore.indexes.json"
  },
  "emulators": {
    "functions": { "port": 5501 },
    "firestore": { "port": 8081 },
    "auth": { "port": 9099 },
    "ui": { "enabled": true, "port": 4010 },
    "hub": { "port": 4410 },
    "logging": { "port": 4510 },
    "singleProjectMode": true
  }
}
